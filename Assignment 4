INF = 9999

n = int(input("Enter number of routers: "))

cost = []
dist = []
nextHop = []

print("Enter the cost matrix (9999 for infinity):")

for i in range(n):
    row = list(map(int, input().split()))
    cost.append(row)
    dist.append(row.copy())

    hops = []
    for j in range(n):
        if i == j:
            hops.append(i)
        elif row[j] != INF:
            hops.append(j)
        else:
            hops.append(-1)
    nextHop.append(hops)


def display():
    for i in range(n):
        print(f"\nRouting Table for Router {i + 1}:")
        print("Destination\tCost\tNext Hop")

        for j in range(n):
            c = "INF" if dist[i][j] == INF else str(dist[i][j])
            h = "-" if nextHop[i][j] == -1 else str(nextHop[i][j] + 1)
            print(f"{j + 1}\t\t{c}\t{h}")


print("\nInitial Routing Tables:")
display()

for k in range(n):
    for i in range(n):
        for j in range(n):
            if dist[i][k] + dist[k][j] < dist[i][j]:
                dist[i][j] = dist[i][k] + dist[k][j]
                nextHop[i][j] = nextHop[i][k]

    print(f"\nAfter Step {k + 1}:")
    display()
