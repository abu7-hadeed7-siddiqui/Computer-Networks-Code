SERVER



import socket

server = socket.socket()
server.bind(('127.0.0.1', 8080))
server.listen(1)

print("Server is waiting for client...")
client, address = server.accept()
print("Client connected!")

while True:
    message = client.recv(1024).decode()

    if not message or message == "exit":
        break

    choice, data = message.split("|", 1)

    if choice == "1":
        result = data
    elif choice == "2":
        try:
            a, op, b = data.split()
            a, b = float(a), float(b)

            if op == '+':
                result = str(a + b)
            elif op == '-':
                result = str(a - b)
            elif op == '*':
                result = str(a * b)
            elif op == '/' and b != 0:
                result = str(a / b)
            elif op == '/':
                result = "Division by zero"
            else:
                result = "Invalid operator"
        except ValueError:
            result = "Invalid expression"
    else:
        result = "Invalid choice"

    client.send(result.encode())

client.close()
server.close()



CLIENT



import socket

client = socket.socket()

client.connect(('127.0.0.1', 8080))
print("Connected to server!")

while True:
    print("\n1. Chat")
    print("2. Mathematical Operations")
    print("3. Exit")

    choice = input("Enter choice: ")

    if choice == "3":
        client.send("exit".encode())
        break

    if choice == "1":
        data = input("Enter message: ")
    elif choice == "2":
        data = input("Enter expression (e.g. 10 + 5): ")
    else:
        print("Invalid choice")
        continue

    client.send((choice + "|" + data).encode())
    print("Server Reply:", client.recv(1024).decode())

client.close()

