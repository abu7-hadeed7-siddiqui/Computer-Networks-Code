def getIpClass(firstOctet):
    if firstOctet >= 0 and firstOctet <= 127:
        return 'A'
    elif firstOctet >= 128 and firstOctet <= 191:
        return 'B'
    elif firstOctet >= 192 and firstOctet <= 223:
        return 'C'
    elif firstOctet >= 224 and firstOctet <= 239:
        return 'D'
    elif firstOctet >= 240 and firstOctet <= 255:
        return 'E'
    else:
        return 'X'

def getDefaultSubnetMask(ipClass):
    if ipClass == 'A':
        return "255.0.0.0"
    elif ipClass == 'B':
        return "255.255.0.0"
    elif ipClass == 'C':
        return "255.255.255.0"
    else:
        return "N/A"

def getNumberOfNetworks(ipClass):
    if ipClass == 'A':
        return "2^7 (128 possible networks, 126 usable)"
    elif ipClass == 'B':
        return "2^14 (16,384 possible networks)"
    elif ipClass == 'C':
        return "2^21 (2,097,152 possible networks)"
    else:
        return "N/A"

def getUsableHosts(ipClass):
    if ipClass == 'A':
        return (1 << 24) - 2
    elif ipClass == 'B':
        return (1 << 16) - 2
    elif ipClass == 'C':
        return (1 << 8) - 2
    else:
        return 0

ip = input("Enter an IP address (format: x.x.x.x): ")

try:
    octets = ip.split('.')
    octet1 = int(octets[0])
    octet2 = int(octets[1])
    octet3 = int(octets[2])
    octet4 = int(octets[3])

    if (0 <= octet1 <= 255 and
        0 <= octet2 <= 255 and
        0 <= octet3 <= 255 and
        0 <= octet4 <= 255):

        print("\n--- Results ---")
        print("IP Address       :", ip)

        if octet1 == 127:
            print("Class            : A (Reserved)")
            print("Notes            : Loopback address (used for local host testing, e.g., localhost).")
            print("Starting IP      : 127.0.0.0")
            print("Last IP          : 127.255.255.255")
        else:
            ipClass = getIpClass(octet1)
            print("Class            :", ipClass)

            if ipClass == 'A' or ipClass == 'B' or ipClass == 'C':
                print("Subnet Mask      :", getDefaultSubnetMask(ipClass))
                print("No. of Networks  :", getNumberOfNetworks(ipClass))
                print("Usable Hosts     :", getUsableHosts(ipClass))

                print("Starting IP      :", end=" ")

                if ipClass == 'A':
                    print(f"{octet1}.0.0.0")
                elif ipClass == 'B':
                    print(f"{octet1}.{octet2}.0.0")
                elif ipClass == 'C':
                    print(f"{octet1}.{octet2}.{octet3}.0")

                print("Last IP          :", end=" ")

                if ipClass == 'A':
                    print(f"{octet1}.255.255.255")
                elif ipClass == 'B':
                    print(f"{octet1}.{octet2}.255.255")
                elif ipClass == 'C':
                    print(f"{octet1}.{octet2}.{octet3}.255")

            elif ipClass == 'D':
                print("Notes            : Multicast address (No standard subnet mask, networks, or hosts)")
            elif ipClass == 'E':
                print("Notes            : Experimental address (No standard subnet mask, networks, or hosts)")
    else:
        print("Invalid IP address format or octets out of bounds (0-255).")

except:
    print("Invalid input.")

